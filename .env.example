# Local environment defaults for docker-compose.yml.
#
# Copy this file to `.env` (next to docker-compose.yml) and adjust the
# values. `.env` is gitignored — never commit real credentials. The values
# below are the built-in defaults applied when `.env` is absent or a
# variable is missing (see the ${VAR:-default} interpolation in
# docker-compose.yml).
#
# SECURITY: these are development defaults for loopback-only use. If you
# point the compose stack at anything beyond localhost, change MONGO_PASSWORD.

# MongoDB root user (created in the admin database on first initialization).
MONGO_USER=dotnetapipi

# MongoDB root password.
MONGO_PASSWORD=secret-dev
