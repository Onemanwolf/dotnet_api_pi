{
  "Storage": {
    "Provider": "sqlite",
    "SqliteConnectionString": "Data Source=dotnet_api_pi.db",
    "MongoConnectionString": "mongodb://localhost:27017",
    "MongoDatabaseName": "dotnet_api_pi"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "Topic": "resource-events"
  },
  "Outbox": {
    "PollIntervalMs": 1000,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "LeaseSeconds": 240,
    "BaseRetryDelayMs": 5000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
