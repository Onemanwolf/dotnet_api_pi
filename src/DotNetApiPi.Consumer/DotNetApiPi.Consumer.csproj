<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kafka consumer (librdkafka-based; the linux runtime binary is pulled
         transitively via Confluent.Kafka). -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- Generic host (IHostedService lifecycle, configuration binding and
         console logging) for the long-running consumer loop. The explicit
         Logging/DI packages are the non-ASP.NET equivalents of what the
         web metapackage provides in the API project. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
